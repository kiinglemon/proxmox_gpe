# ============================================================================
#  InfraOne — configuration (copiez ce fichier en config/infraone.env)
#  Le script setup/bootstrap.sh génère automatiquement config/infraone.env.
# ============================================================================

# --- Application / sécurité -------------------------------------------------
INFRAONE_HOST=0.0.0.0
INFRAONE_PORT=8000
# Clé secrète JWT : GÉNÉREZ-EN UNE (openssl rand -hex 32)
INFRAONE_SECRET_KEY=change-me-please-generate-a-random-key
INFRAONE_ADMIN_USER=admin
INFRAONE_ADMIN_PASSWORD=infraone

# --- Mode de fonctionnement -------------------------------------------------
# 1 = mode démo simulé (aucune infra requise) ; 0 = vrai Proxmox
INFRAONE_MOCK_PROXMOX=0

# --- Connexion Proxmox ------------------------------------------------------
PROXMOX_HOST=127.0.0.1:8006
PROXMOX_NODE=pve
# Token créé par setup/20-proxmox-apiuser.sh (format user@realm!nom)
PROXMOX_TOKEN_ID=infraone@pve!automation
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false

# --- Provisioning (valeurs calibrées pour 10 Go RAM / 4 vCPU) --------------
INFRAONE_TEMPLATE_ID=9000
INFRAONE_STORAGE=local-lvm
INFRAONE_BRIDGE=vmbr0
INFRAONE_VMID_MIN=100
INFRAONE_VMID_MAX=199
DEFAULT_VM_CORES=1
DEFAULT_VM_MEMORY=1024
DEFAULT_VM_DISK_GB=8
MAX_VM_CORES=4
MAX_VM_MEMORY=4096
MAX_VM_DISK_GB=40

# --- Cloud-init / SSH -------------------------------------------------------
DEFAULT_CI_USER=infra
DEFAULT_CI_PASSWORD=infraone
# SSH_PUBLIC_KEY_PATH=/root/.ssh/id_rsa.pub
